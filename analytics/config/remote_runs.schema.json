{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro de ejecuciones remotas Colab CLI",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status", "increment", "scope", "package", "command", "do_not_repeat"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["prepared", "uploaded", "running", "backup_verified", "accepted", "failed", "timeout_manual_review", "closed"]},
          "increment": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "session": {"type": "string"},
          "command": {"type": "string", "minLength": 1},
          "baseline": {"type": "string"},
          "artifacts": {"type": "array", "items": {"type": "string"}},
          "verification": {"type": "array", "items": {"type": "string"}},
          "do_not_repeat": {"type": "array", "items": {"type": "string"}},
          "next_action": {"type": "string"}
        }
      }
    }
  }
}
