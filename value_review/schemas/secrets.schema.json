{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-review.invalid/schemas/secrets.schema.json",
  "title": "API keys (annotations/secrets.json, 52-models-keys-interface-contract.md; ADR-020). Never exported; the service returns only the last 4 characters of a key.",
  "type": "object",
  "required": ["schema", "keys"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "value-review-secrets/1" },
    "keys": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "provider", "name", "key", "default", "added_at", "tested_at", "models"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^k_[0-9a-f]{8}$" },
          "provider": { "enum": ["anthropic", "openai", "google", "server"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "key": { "type": "string", "minLength": 8, "maxLength": 500 },
          "url": { "type": "string", "maxLength": 500, "description": "Own server only: its OpenAI-compatible base URL." },
          "monthly_limit_usd": { "type": ["number", "null"], "minimum": 0, "maximum": 1000000 },
          "default": { "type": "boolean", "description": "One default per provider (BR-K02)." },
          "added_at": { "type": "string", "format": "date-time" },
          "tested_at": { "type": "string", "format": "date-time" },
          "models": { "type": "array", "maxItems": 2000, "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "description": "Model ids the provider listed at the last test." }
        }
      }
    }
  }
}
