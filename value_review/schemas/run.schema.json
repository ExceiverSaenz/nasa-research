{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-review.invalid/schemas/run.schema.json",
  "title": "One extraction run (<data>/extraction/runs/<id>/run.json, OP-X01 of 72-extraction-interface-contract.md).",
  "type": "object",
  "required": ["schema", "id", "name", "set", "folder", "schema_ref", "model", "key_id", "status", "created_at", "created_by",
               "launched_at", "finished_at", "prompt_version", "system_prompt_version", "copied_from"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "value-review-run/1" },
    "id": { "type": "string", "pattern": "^r_[0-9a-f]{8}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "set": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Folder name under papers/ in the workspace." },
    "folder": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$", "description": "Folder under results/<set>/; never changes (renaming changes only the name)." },
    "schema_ref": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "maxLength": 64 }, "version": { "type": "integer", "minimum": 1 } }
    },
    "model": { "type": ["string", "null"], "maxLength": 210, "description": "<provider>:<model>, as in GET /models." },
    "key_id": { "type": ["string", "null"], "pattern": "^k_[0-9a-f]{8}$" },
    "status": { "enum": ["draft", "running", "paused", "complete", "cancelled"] },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 80 },
    "launched_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "prompt_version": { "type": "integer", "minimum": 0, "description": "The prompt version used at the first launch; 0 before." },
    "system_prompt_version": { "type": ["integer", "null"], "minimum": 1 },
    "copied_from": { "type": ["string", "null"], "pattern": "^r_[0-9a-f]{8}$" }
  }
}
