{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-review.invalid/schemas/original.schema.json",
  "title": "Immutable original of one paper (originals/<n>.json), written once by ingest",
  "type": "object",
  "required": ["schema", "paper", "source", "document", "pages", "features", "records", "observations", "counts", "issues"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "value-review-original/1" },
    "paper": { "type": "string", "pattern": "^[0-9]{1,4}$" },
    "source": {
      "type": "object", "required": ["run_id", "mode", "result_file", "result_sha256", "pdf_file", "pdf_sha256"], "additionalProperties": false,
      "properties": {
        "run_id": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "result_file": { "type": "string" },
        "result_sha256": { "$ref": "#/$defs/sha" },
        "pdf_file": { "type": "string" },
        "pdf_sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "document": {
      "type": "object", "required": ["title", "page_count", "completion"], "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "page_count": { "type": "integer", "minimum": 1 },
        "completion": {
          "type": "object", "required": ["status", "pages_unreviewed", "summary"], "additionalProperties": false,
          "properties": {
            "status": { "enum": ["complete", "partial", "blocked", null] },
            "pages_unreviewed": { "type": "array", "items": { "type": "integer" } },
            "summary": { "type": "string" }
          }
        }
      }
    },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["number", "width_pt", "height_pt"], "additionalProperties": false,
        "properties": { "number": { "type": "integer", "minimum": 1 }, "width_pt": { "type": "number", "exclusiveMinimum": 0 }, "height_pt": { "type": "number", "exclusiveMinimum": 0 } }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object", "required": ["feature_id", "label"], "additionalProperties": false,
        "properties": { "feature_id": { "type": "string" }, "label": { "type": "string", "minLength": 1 } }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object", "required": ["record_id", "label", "summary", "kind", "statistic", "replicate_count", "notes"], "additionalProperties": false,
        "properties": {
          "record_id": { "type": "string" }, "label": { "type": "string" }, "summary": { "type": "string" },
          "kind": { "type": ["string", "null"] }, "statistic": { "type": ["string", "null"] },
          "replicate_count": { "type": ["integer", "string", "null"] }, "notes": { "type": "string" }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["observation_id", "feature_id", "record_ids", "candidate_record_ids", "assignment_status", "scope", "source_status", "value", "unit", "flags", "derivation", "notes", "needs_check", "action", "info", "evidence"],
        "additionalProperties": false,
        "properties": {
          "observation_id": { "type": "string" },
          "feature_id": { "type": "string" },
          "record_ids": { "type": "array", "items": { "type": "string" } },
          "candidate_record_ids": { "type": "array", "items": { "type": "string" } },
          "assignment_status": { "type": ["string", "null"] },
          "scope": { "type": ["string", "null"] },
          "source_status": { "type": ["string", "null"] },
          "value": { "type": ["string", "null"] },
          "unit": { "type": ["string", "null"] },
          "flags": { "type": "array", "items": { "type": "string" } },
          "derivation": { "type": ["object", "null"] },
          "notes": { "type": "string" },
          "needs_check": { "type": "boolean" },
          "action": { "type": "array", "items": { "type": "string" } },
          "info": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "page", "bbox", "role", "text", "location_quality", "region_id", "region_kind", "region_label"],
              "additionalProperties": false,
              "properties": {
                "evidence_id": { "type": "string" },
                "page": { "type": "integer", "minimum": 1 },
                "bbox": { "oneOf": [ { "type": "null" }, { "$ref": "state.schema.json#/$defs/bbox" } ] },
                "role": { "type": ["string", "null"] },
                "text": { "type": ["string", "null"] },
                "location_quality": { "type": ["string", "null"] },
                "region_id": { "type": "string" },
                "region_kind": { "type": ["string", "null"] },
                "region_label": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object", "required": ["records", "values", "needs_check"], "additionalProperties": false,
      "properties": { "records": { "type": "integer", "minimum": 0 }, "values": { "type": "integer", "minimum": 0 }, "needs_check": { "type": "integer", "minimum": 0 } }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "required": ["code", "ref"], "additionalProperties": false,
        "properties": { "code": { "enum": ["pdf_hash_mismatch", "unknown_evidence", "unknown_region", "page_out_of_range", "unknown_record"] }, "ref": { "type": "string" } }
      }
    }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
