{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://value-review.invalid/schemas/schema-content.schema.json",
  "title": "Content of one schema: its groups and fields (versioned; 22-schema-interface-contract.md)",
  "description": "Shape only. Business rules (unique names, formula inputs, unit only on numbers) are checked by domain/schema_rules.py and reported as rules_violation, not here.",
  "type": "object",
  "required": ["schema", "description", "groups"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "value-review-schema/1" },
    "description": { "type": "string", "maxLength": 2000 },
    "groups": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Internal id. Never changes, never reused inside the schema (BR-S02)."
    },
    "group": {
      "type": "object",
      "required": ["group_id", "name", "fields"],
      "additionalProperties": false,
      "properties": {
        "group_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 120 },
        "fields": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["field_id", "name", "description", "type", "unit", "allowed", "multiple", "formula", "inputs", "family"],
      "additionalProperties": false,
      "properties": {
        "field_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "type": { "enum": ["number", "category", "text", "calculated"] },
        "unit": { "type": "string", "maxLength": 40, "description": "Target unit; only meaningful for type number (BR-S04)." },
        "allowed": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": "Allowed values of a category. They guide the model and never reject a value."
        },
        "multiple": { "type": "boolean", "description": "A category may take several values." },
        "formula": { "type": "string", "maxLength": 500, "description": "Formula of a calculated field, written with field names." },
        "inputs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" },
          "description": "field_ids the formula reads."
        },
        "family": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["family_id", "name", "member"],
              "additionalProperties": false,
              "properties": {
                "family_id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "maxLength": 120 },
                "member": { "type": "string", "minLength": 1, "maxLength": 40, "description": "This field's member of the family, for example Cr." }
              }
            }
          ]
        }
      }
    }
  }
}
