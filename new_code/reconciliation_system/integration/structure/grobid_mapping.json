{
  "version": "grobid-mapping/1",
  "policy": "retain_B_on_conflict; model_inferred_only; no_fuzzy_adoption",
  "rules": [
    {"tag":"title","context":"bibliography","values":{"document_role":"reference_title","function":"bibliography","flow":"bibliography"}},
    {"tag":"title","context":"header","values":{"document_role":"article_title","category":"title","function":"metadata","flow":"front_matter"}},
    {"tag":"persName","context":"bibliography","values":{"document_role":"cited_author"},"force_fragment":true},
    {"tag":"persName","context":"header","values":{"document_role":"authorship","function":"metadata","flow":"front_matter"},"force_fragment":true},
    {"tag":"author","context":"header","values":{"document_role":"authorship","function":"metadata","flow":"front_matter"}},
    {"tag":"affiliation","context":"header","values":{"document_role":"affiliation","function":"metadata","flow":"front_matter"}},
    {"tag":"abstract","context":"any","values":{"document_role":"abstract_body","function":"metadata","flow":"front_matter"}},
    {"tag":"keywords","context":"any","values":{"document_role":"keywords","function":"metadata","flow":"front_matter"}},
    {"tag":"head","context":"figure","values":{"document_role":"caption","function":"associated_content","category":"caption"}},
    {"tag":"figDesc","context":"figure","values":{"document_role":"caption","function":"associated_content","category":"caption"}},
    {"tag":"label","context":"figure","values":{"document_role":"visual_label"},"force_fragment":true},
    {"tag":"graphic","context":"figure","values":{"document_role":"visual_resource"},"force_fragment":true},
    {"tag":"head","context":"body","values":{"document_role":"section_heading","category":"title","function":"main_body"}},
    {"tag":"p","context":"abstract","values":{"document_role":"abstract_body","function":"metadata","flow":"front_matter"}},
    {"tag":"p","context":"note","values":{"document_role":"note_text","flow":"notes"}},
    {"tag":"p","context":"bibliography","values":{"document_role":"bibliographic_text","function":"bibliography","flow":"bibliography"}},
    {"tag":"p","context":"body","values":{"document_role":"body_paragraph","function":"main_body","category":"text"}},
    {"tag":"figure","type":"table","context":"any","values":{"document_role":"table_object"},"force_fragment":true},
    {"tag":"figure","context":"any","values":{"document_role":"figure_object"},"force_fragment":true},
    {"tag":"formula","context":"any","values":{"document_role":"equation","category":"equation"}},
    {"tag":"note","context":"any","values":{"document_role":"note_text","flow":"notes"}},
    {"tag":"ref","context":"any","values":{"document_role":"cross_reference"},"force_fragment":true},
    {"tag":"biblStruct","context":"bibliography","values":{"document_role":"bibliographic_entry","function":"bibliography","flow":"bibliography"}}
  ]
}
